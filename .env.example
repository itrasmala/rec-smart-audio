# ---- REC Smart Audio — docker compose settings (install.sh fills these in for you) ----
# DNS name pointing to this server. No domain? use <your-ip-with-dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
DOMAIN=audio.example.com
# strong random password:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me
# one-time code to create the first admin in the browser
SETUP_CODE=ABCD-1234
# prebuilt image from GitHub Actions (leave empty to build locally)
REC_IMAGE=
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=60
LOG_LEVEL=info
