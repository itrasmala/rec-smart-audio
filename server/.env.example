# ---- REC Smart Audio server ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://rec:rec@localhost:5432/rec_audio
# where uploaded audio files are stored
STORAGE_DIR=./data/audio
# Next.js static export of the dashboard (cd ../web && npm run build)
WEB_DIR=../web/out
# public URL of the dashboard, used for CSRF origin checks (no trailing slash)
PUBLIC_ORIGIN=
# true in production behind HTTPS
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=60
LOG_LEVEL=info
